FROM node:22-bookworm

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

# Install Playwright's bundled Chromium and its OS dependencies
RUN npx playwright install chromium --with-deps

COPY scripts/ scripts/

ENV DATA_DIR=/app/data
ENV BROWSER_DATA_DIR=/app/.browser-data
ENV PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=1
ENV FETCH_INTERVAL=21600

RUN mkdir -p /app/data/gpx /app/data/tcx /app/.browser-data

CMD ["npm", "run", "fetcher"]
